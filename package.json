{
  "name": "@epistemics/opendiscovery-boltz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "General Epistemics",
  "description": "Boltz molecular prediction and design workflows for OpenDiscovery.",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.22.0",
    "zod": "3.25.76"
  },
  "opendiscovery": {
    "apiVersion": 2,
    "contributes": {
      "panel": {
        "id": "boltz",
        "name": "Boltz",
        "icon": "server"
      },
      "mcpServers": [
        {
          "id": "boltz",
          "type": "local",
          "runtime": "node",
          "entry": "runtime/server.mjs",
          "requireApproval": [
            "boltz_install_cli",
            "boltz_auth_login",
            "boltz_structure_and_binding",
            "boltz_small_molecule_screen",
            "boltz_small_molecule_design",
            "boltz_protein_screen",
            "boltz_protein_design",
            "boltz_download_results"
          ]
        }
      ],
      "skills": [
        {
          "id": "boltz-cli-setup",
          "path": "skills/boltz-cli-setup"
        },
        {
          "id": "boltz-check-status",
          "path": "skills/boltz-check-status"
        },
        {
          "id": "boltz-structure-and-binding",
          "path": "skills/boltz-structure-and-binding"
        },
        {
          "id": "boltz-small-molecule-screen",
          "path": "skills/boltz-small-molecule-screen"
        },
        {
          "id": "boltz-small-molecule-design",
          "path": "skills/boltz-small-molecule-design"
        },
        {
          "id": "boltz-protein-screen",
          "path": "skills/boltz-protein-screen"
        },
        {
          "id": "boltz-protein-design",
          "path": "skills/boltz-protein-design"
        }
      ]
    }
  }
}
